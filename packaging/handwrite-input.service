[Unit]
Description=Handwrite Input handwriting overlay
Documentation=https://github.com/tanmayd-dev/handwrite-input
# Started with the graphical session; the overlay needs a running Wayland
# compositor. Compositors that do not reach graphical-session.target (plain
# Hyprland without uwsm, for example) should start the unit from their own
# config instead: systemctl --user start handwrite-input
PartOf=graphical-session.target
After=graphical-session.target

[Service]
Type=simple
ExecStart=/usr/bin/handwrite-input
Restart=on-failure
RestartSec=3

[Install]
WantedBy=graphical-session.target
